# Runtime state belongs outside the source checkout in production.
PERSONAL_OS_DATA_DIR=/var/lib/personal-os-calendar

# Telegram allow-list. Keep these values only in your secret manager/.env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Either pass --source-url to the bot or configure a source in the application.
UNIVERSITY_SCHEDULE_URL=
# Preferred TPU setting: stable group page. The bot checks TPU periods 1 and 2
# automatically and selects the one with current/future lessons; the temporary
# iCal key is discovered in memory before each update and is never saved.
TPU_SCHEDULE_VIEW_URL=
# 1=week, 2=current + following week, 3=month.
TPU_SCHEDULE_EXPORT_VARIANT=2

# OAuth paths are supplied by the deployment runtime, never hard-coded in code.
GOOGLE_CALENDAR_CREDENTIALS_PATH=
GOOGLE_CALENDAR_TOKEN_PATH=
